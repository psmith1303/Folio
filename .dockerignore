# Keep the build context small and reproducible.
.git
.gitignore
.ruff_cache
__pycache__/
*.py[cod]
*.log
# Syncthing's temporary files (the source reaches the Docker host by Syncthing)
**/.syncthing.*
**/~syncthing~*

# Dev-only / not needed in the image. tests/, scripts/, requirements-dev.txt
# and pytest.ini stay in the context: the `test` target copies them (the
# runtime stage copies only web/).
docs/
*.el
*.md
*.pdf
icon.png
folio.sh

# Runtime config/data (never bake into the image)
config.json
.folio/
